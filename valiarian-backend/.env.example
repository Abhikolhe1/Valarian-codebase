WHATSAPP_WELCOME_TEMPLATE=
META_APP_ID=
META_APP_SECRET=
API_ENDPOINT="http://localhost:3035"
SERVER_ENDPOINT=""

# POSTRES Connection
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=valiarian

# JWT SECRETS
JWT_SECRET=
