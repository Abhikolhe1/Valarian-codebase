# Copy to .env and fill in real values locally. Never commit .env.
# This file lists every variable name the backend actually reads from
# process.env — see src/datasources, src/services, src/controllers.

# --- Database (loopback-connector-postgresql) ---
PG_HOST=
PG_PORT=
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# --- Server ---
PORT=
HOST=
NODE_ENV=
CORS_ORIGIN=
FRONTEND_URL=
API_ENDPOINT=
SERVER_ENDPOINT=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_REJECT_UNAUTHORIZED=
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=
ADMIN_ORDER_NOTIFICATION_EMAILS=
LOW_STOCK_ALERT_EMAIL=

# --- Orders ---
ORDER_PREFIX=
RETURN_WINDOW_DAYS=
PENDING_ORDER_CLEANUP_HOURS=
PENDING_ORDER_CLEANUP_INTERVAL_MS=
PREMIUM_PREORDER_EXPIRY_MINUTES=
PREMIUM_PREORDER_EXPIRY_INTERVAL_MS=

# --- BlueDart shipping ---
BLUEDART_ENV=
BLUEDART_API_VERSION=
BLUEDART_LOGIN_ID=
BLUEDART_LICENCE_KEY=
BLUEDART_CUSTOMER_CODE=
BLUEDART_AREA_CODE=
BLUEDART_ORIGIN_AREA=
BLUEDART_PRODUCT_CODE=
BLUEDART_SUB_PRODUCT_CODE=
BLUEDART_SERVICE_TYPE=
BLUEDART_COD_FAVOR_OF=
BLUEDART_DEFAULT_WEIGHT_GRAMS=
BLUEDART_DEFAULT_LENGTH_CM=
BLUEDART_DEFAULT_BREADTH_CM=
BLUEDART_DEFAULT_HEIGHT_CM=
BLUEDART_VOLUMETRIC_DIVISOR=
SHIPPING_API_MAX_RETRIES=
SHIPPING_API_RETRY_DELAY_MS=
SHIPPING_API_MAX_CONCURRENT=
SERVICEABILITY_CACHE_TTL_HOURS=

# --- Tracking / retention (referenced in .env but not currently read by any
#     code path as of this audit — kept here for parity, confirm before relying on them) ---
NDR_AUTO_ESCALATION_DAYS=
RTO_AUTO_RESTORE_INVENTORY=
TRACKING_SYNC_CRON=
TRACKING_SYNC_BATCH_SIZE=
TRACKING_CACHE_TTL_MINUTES=
TRACKING_EVENT_RETENTION_MONTHS=
TRACKING_EVENT_HARD_DELETE_MONTHS=
RETENTION_CRON=
RETENTION_BATCH_SIZE=

# --- Storage ---
STORAGE_PATH=
