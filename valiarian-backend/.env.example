# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Order Configuration
ORDER_PREFIX=ORD
RETURN_WINDOW_DAYS=7

#Order Email Notifications
ADMIN_ORDER_NOTIFICATION_EMAILS=
# SUPER_ADMIN_EMAIL=support@valiarian.com

#Contact Form Email Send To RECIPIENTS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REJECT_UNAUTHORIZED=false

EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Low Stock Alert Configuration
LOW_STOCK_ALERT_EMAIL=

# CRON-JOB CONFIGURATION
PENDING_ORDER_CLEANUP_HOURS=2
PENDING_ORDER_CLEANUP_INTERVAL_MS=7200000
# PREMIUM PREORDER CONFIGURATION
PREMIUM_PREORDER_EXPIRY_MINUTES=60
PREMIUM_PREORDER_EXPIRY_INTERVAL_MS=300000

# ── Blue Dart API ────────────────────────────────────────────
# Explicit provider selection; never inferred from credentials.
BLUEDART_PROVIDER_MODE=developer-portal  # legacy-soap | developer-portal

# BLUEDART_ENV is the single source of truth for environment selection.
# Switching sandbox -> production later requires ONLY this value plus the
# BLUEDART_PRODUCTION_* vars below — no code/service/controller change.
BLUEDART_ENV=sandbox                     # sandbox | production

# Developer Portal/Apigee App credentials — backend-only. Never use REACT_APP_,
# VITE_, NEXT_PUBLIC_, or PUBLIC_ prefixes. Used only to fetch the JWT token.
BLUEDART_API_KEY=
BLUEDART_API_SECRET=

# Blue Dart customer/business profile credentials — DIFFERENT from the
# Developer Portal API key/secret above. Obtained via manual document
# verification at a regional Blue Dart office, never via the developer
# portal. Required inside every business call's `profile` object.
BLUEDART_LOGIN_ID=
BLUEDART_LICENCE_KEY=

# ── Sandbox ────────────────────────────────────────────────────
# Auth URL per official DHL Developer Portal documentation.
BLUEDART_SANDBOX_AUTH_URL=https://apigateway-sandbox.bluedart.com/in/transportation/token/v1/login
# Finder base URL — confirmed via live probe, not the older PDF-documented
# "-uat" host (that one's TLS cert no longer matches Blue Dart at all).
BLUEDART_SANDBOX_BASE_URL=https://apigateway-sandbox.bluedart.com/in/transportation/finder/v1

# ── Production — prepared, not active while BLUEDART_ENV=sandbox ───────
BLUEDART_PRODUCTION_AUTH_URL=https://apigateway.bluedart.com/in/transportation/token/v1/login
BLUEDART_PRODUCTION_BASE_URL=https://apigateway.bluedart.com/in/transportation/finder/v1

BLUEDART_REQUEST_TIMEOUT_MS=30000
BLUEDART_TOKEN_REFRESH_BUFFER_SECONDS=300
BLUEDART_TOKEN_FALLBACK_TTL_SECONDS=900

# Endpoint paths, relative, appended to BASE_URL above.
BLUEDART_SERVICEABILITY_PATH=/GetServicesforPincode
BLUEDART_WAYBILL_PATH=
BLUEDART_CANCEL_WAYBILL_PATH=
BLUEDART_TRACKING_PATH=
BLUEDART_PICKUP_REGISTRATION_PATH=
BLUEDART_PICKUP_CANCELLATION_PATH=
BLUEDART_TRANSIT_TIME_PATH=
BLUEDART_PRODUCTS_PATH=
BLUEDART_LABEL_PATH=

# Modern payload profile: none | customer-only | legacy-profile.
BLUEDART_MODERN_PROFILE_MODE=none
BLUEDART_PICKUP_LOCATION_CODE=

# Explicit test-only mocks. Prohibited when environment is production.
BLUEDART_ENABLE_TEST_MOCKS=false
BLUEDART_RUN_INTEGRATION_TESTS=false

# Legacy credentials remain required only for legacy-soap live calls.
BLUEDART_LOGIN_ID=
BLUEDART_LICENCE_KEY=
BLUEDART_API_VERSION=1.10
BLUEDART_CUSTOMER_CODE=
BLUEDART_ORIGIN_AREA=BOM
BLUEDART_AREA_CODE=MUM
BLUEDART_SERVICE_TYPE=A
BLUEDART_PRODUCT_CODE=D
BLUEDART_SUB_PRODUCT_CODE=
BLUEDART_SHIPPER_NAME=
BLUEDART_SHIPPER_ADDRESS_LINE1=
BLUEDART_SHIPPER_CITY=
BLUEDART_SHIPPER_STATE=
BLUEDART_SHIPPER_PINCODE=
BLUEDART_SHIPPER_PHONE=
COMPANY_NAME="VALIARIAN LLP"
COMPANY_GST_NUMBER=27ABBFV5019J1Z0
BLUEDART_ENV=TEST                    # TEST | PROD

# ── Shipment defaults ────────────────────────────────────────
BLUEDART_DEFAULT_WEIGHT_GRAMS=500
BLUEDART_DEFAULT_LENGTH_CM=20
BLUEDART_DEFAULT_BREADTH_CM=15
BLUEDART_DEFAULT_HEIGHT_CM=10
BLUEDART_VOLUMETRIC_DIVISOR=5000

# ── Retry & Rate Limiting ────────────────────────────────────
SHIPPING_API_MAX_RETRIES=3
SHIPPING_API_RETRY_DELAY_MS=1000
SHIPPING_API_MAX_CONCURRENT=5

# ── Tracking Sync ────────────────────────────────────────────
TRACKING_SYNC_CRON=*/30 * * * *
TRACKING_SYNC_BATCH_SIZE=10
TRACKING_CACHE_TTL_MINUTES=15
SERVICEABILITY_CACHE_TTL_HOURS=24

# ── RTO ──────────────────────────────────────────────────────
RTO_AUTO_RESTORE_INVENTORY=true

# ── COD ──────────────────────────────────────────────────────
BLUEDART_COD_FAVOR_OF="Valiarian Pvt Ltd"

# ── NDR ──────────────────────────────────────────────────────
NDR_AUTO_ESCALATION_DAYS=3

# ── Tracking Event Retention ──────────────────────────────────
TRACKING_EVENT_RETENTION_MONTHS=24
TRACKING_EVENT_HARD_DELETE_MONTHS=60
RETENTION_BATCH_SIZE=1000
RETENTION_CRON="0 2 * * 0"

# Local file storage
STORAGE_PATH=
