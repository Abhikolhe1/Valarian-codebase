PORT=3035
# environment
NODE_ENV=dev
API_ENDPOINT="http://localhost:3035"
SERVER_ENDPOINT=""

# POSTRES Connection
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=valiarian

# JWT SECRETS
JWT_SECRET=
JWT_EXPIRES_IN=29d

# EMAIL SECRETS
EMAIL_USER=
EMAIL_PASS=

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3035/api/auth/google/callback

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Order Configuration
ORDER_PREFIX=ORD
RETURN_WINDOW_DAYS=7

#Order Email Notifications
ADMIN_ORDER_NOTIFICATION_EMAILS=
# SUPER_ADMIN_EMAIL=support@valiarian.com

#Contact Form Email Send To RECIPIENTS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REJECT_UNAUTHORIZED=false

EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Low Stock Alert Configuration
LOW_STOCK_ALERT_EMAIL=

# CRON-JOB CONFIGURATION
PENDING_ORDER_CLEANUP_HOURS=2
PENDING_ORDER_CLEANUP_INTERVAL_MS=7200000
# PREMIUM PREORDER CONFIGURATION
PREMIUM_PREORDER_EXPIRY_MINUTES=60
PREMIUM_PREORDER_EXPIRY_INTERVAL_MS=300000

# ── Blue Dart API ────────────────────────────────────────────
# Explicit provider selection; never inferred from credentials.
BLUEDART_PROVIDER_MODE=legacy-soap       # legacy-soap | developer-portal
BLUEDART_ENVIRONMENT=sandbox             # sandbox | production

# Developer Portal/Apigee credentials are backend-only. Never use REACT_APP_,
# VITE_, NEXT_PUBLIC_, or PUBLIC_ prefixes. API Key is the client/consumer key
# and API Secret is the client/consumer secret, subject to DHL confirmation.
BLUEDART_API_KEY=
BLUEDART_API_SECRET=
# Exact URLs must be supplied by Blue Dart/DHL; there are no code defaults.
BLUEDART_AUTH_URL=
BLUEDART_BASE_URL=
BLUEDART_REQUEST_TIMEOUT_MS=30000
BLUEDART_TOKEN_REFRESH_BUFFER_SECONDS=300
BLUEDART_TOKEN_FALLBACK_TTL_SECONDS=900

# Endpoint paths are intentionally blank until the official contract is known.
BLUEDART_SERVICEABILITY_PATH=
BLUEDART_WAYBILL_PATH=
BLUEDART_CANCEL_WAYBILL_PATH=
BLUEDART_TRACKING_PATH=
BLUEDART_PICKUP_REGISTRATION_PATH=
BLUEDART_PICKUP_CANCELLATION_PATH=
BLUEDART_TRANSIT_TIME_PATH=
BLUEDART_PRODUCTS_PATH=
BLUEDART_LABEL_PATH=

# Modern payload profile: none | customer-only | legacy-profile.
BLUEDART_MODERN_PROFILE_MODE=none
BLUEDART_PICKUP_LOCATION_CODE=

# Explicit test-only mocks. Prohibited when environment is production.
BLUEDART_ENABLE_TEST_MOCKS=false
BLUEDART_RUN_INTEGRATION_TESTS=false

# Legacy credentials remain required only for legacy-soap live calls.
BLUEDART_LOGIN_ID=
BLUEDART_LICENCE_KEY=
BLUEDART_API_VERSION=1.10
BLUEDART_CUSTOMER_CODE=
BLUEDART_ORIGIN_AREA=BOM
BLUEDART_AREA_CODE=MUM
BLUEDART_SERVICE_TYPE=A
BLUEDART_PRODUCT_CODE=A
BLUEDART_SUB_PRODUCT_CODE=P
BLUEDART_ENV=TEST                    # TEST | PROD

# ── Shipment defaults ────────────────────────────────────────
BLUEDART_DEFAULT_WEIGHT_GRAMS=500
BLUEDART_DEFAULT_LENGTH_CM=20
BLUEDART_DEFAULT_BREADTH_CM=15
BLUEDART_DEFAULT_HEIGHT_CM=10
BLUEDART_VOLUMETRIC_DIVISOR=5000

# ── Retry & Rate Limiting ────────────────────────────────────
SHIPPING_API_MAX_RETRIES=3
SHIPPING_API_RETRY_DELAY_MS=1000
SHIPPING_API_MAX_CONCURRENT=5

# ── Tracking Sync ────────────────────────────────────────────
TRACKING_SYNC_CRON=*/30 * * * *
TRACKING_SYNC_BATCH_SIZE=10
TRACKING_CACHE_TTL_MINUTES=15
SERVICEABILITY_CACHE_TTL_HOURS=24

# ── RTO ──────────────────────────────────────────────────────
RTO_AUTO_RESTORE_INVENTORY=true

# ── COD ──────────────────────────────────────────────────────
BLUEDART_COD_FAVOR_OF="Valiarian Pvt Ltd"

# ── NDR ──────────────────────────────────────────────────────
NDR_AUTO_ESCALATION_DAYS=3

# ── Tracking Event Retention ──────────────────────────────────
TRACKING_EVENT_RETENTION_MONTHS=24
TRACKING_EVENT_HARD_DELETE_MONTHS=60
RETENTION_BATCH_SIZE=1000
RETENTION_CRON="0 2 * * 0"
